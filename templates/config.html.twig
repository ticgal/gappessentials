{% import 'components/form/fields_macros.html.twig' as fields %}

<form name="gappessentials_config" method="post" action="{{ path('/plugins/gappessentials/front/config.form.php') }}">
    <input type="hidden" name="id" value="{{ item.fields['id'] }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

    <div class="card-body">
        <div class="row">
            {{ fields.dropdownField(
                'RequestType',
                'requesttypes_id',
                item.fields['requesttypes_id'],
                label_request_source,
                {
                    'condition': {'is_active': 1, 'is_ticketheader': 1},
                    'disabled': not can_update
                }
            ) }}
        </div>
    </div>

    {% if can_update %}
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i>
                <span>{{ _x('button', 'Save') }}</span>
            </button>
        </div>
    {% endif %}
</form>
